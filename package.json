{
	"name": "huddle-backend",
	"version": "0.1.0",
	"description": "Huddle backend — authentication + channel messaging (Sprint 1).",
	"main": "src/server.js",
	"private": true,
	"engines": {
		"node": ">=18.0.0"
	},
	"scripts": {
		"dev": "nodemon src/server.js",
		"start": "node src/server.js",
		"postinstall": "prisma generate",
		"migrate:dev": "prisma migrate dev",
		"migrate:deploy": "prisma migrate deploy",
		"test": "jest --runInBand --testMatch=\"**/*.tests.js\""
	},
	"dependencies": {
		"@prisma/client": "^7.10.0",
		"bcrypt": "^6.0.0",
		"cors": "^2.8.5",
		"dotenv": "^16.4.5",
		"express": "^4.19.2",
		"jsonwebtoken": "^9.0.3",
		"prisma": "^7.10.0"
	},
	"devDependencies": {
		"jest": "^30.5.1",
		"nodemon": "^3.1.4",
		"supertest": "^7.2.2"
	}
}
