generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  createdWorkspaces   Workspace[]           @relation("WorkspaceCreator")
  workspaceMemberships WorkspaceMembership[]
  createdChannels     Channel[]             @relation("ChannelCreator")
  channelMemberships  ChannelMembership[]
  messages            Message[]

  @@map("users")
}

// A workspace is where channels exist. Created explicitly by a user;
// joined by anyone who has the workspace's id (no invite-code system yet —
// that's a Sprint 2 concern, this is the minimum that makes isolation real).
model Workspace {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  createdBy Int      @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  // createdBy identifies the owner for now — a real role system
  // (owner/manager/member) is a later feature, not built yet.
  creator     User                  @relation("WorkspaceCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  memberships WorkspaceMembership[]
  channels    Channel[]

  @@map("workspaces")
}

model WorkspaceMembership {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  workspaceId Int      @map("workspace_id")
  joinedAt    DateTime @default(now()) @map("joined_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("workspace_memberships")
}

enum ChannelStatus {
  ACTIVE
  CLOSED
}

model Channel {
  id          Int           @id @default(autoincrement())
  workspaceId Int           @map("workspace_id")
  name        String        @db.VarChar(64)
  description String?       @db.VarChar(280)
  createdBy   Int           @map("created_by")
  // Set true only for the auto-created #general/#announcements channels —
  // joining a workspace auto-joins you to these, not to every channel.
  isDefault   Boolean       @default(false) @map("is_default")
  status      ChannelStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator     User                @relation("ChannelCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  memberships ChannelMembership[]
  messages    Message[]

  // Channel names are unique per workspace now, not globally — every
  // workspace gets its own #general, that's the whole point.
  @@unique([workspaceId, name])
  @@map("channels")
}

model ChannelMembership {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  channelId Int      @map("channel_id")
  joinedAt  DateTime @default(now()) @map("joined_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@map("channel_memberships")
}

model Message {
  id        Int      @id @default(autoincrement())
  body      String   @db.Text
  userId    Int      @map("user_id")
  channelId Int      @map("channel_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
  @@map("messages")
}
